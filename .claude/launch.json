{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "academy-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../academy-api && exec bun src/index.ts"
      ],
      "port": 6112
    }
  ]
}
